[include]
  path = ~/.gitconfig.local
[core]
	excludesfile = /Users/kei-p/.gitignore_global
  editor = vim -c \"set fenc=utf-8\"
[difftool "sourcetree"]
  cmd = opendiff \"$LOCAL\" \"$REMOTE\"
[mergetool "sourcetree"]
  cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
  trustExitCode = true
[alias]
  ctree = log --color --graph --date-order --pretty=format:'%x09%C(yellow)%h%Creset%x09%C(red)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  tree = log --color --graph --date-order --all --pretty=format:'%x09%C(yellow)%h%Creset%x09%C(red)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  ck = checkout
  dfcached = diff --cached
  pff = pull --ff-only
  prebase = pull --rebase
  fprune = fetch --prune
  prbdev = pull --rebase origin develop
  ffs = flow feature start
  fff = flow feature finish
  nbranch = checkout -b
  dbranch = branch -D
  cbranch = "!f(){ git nbranch \"$2\" \"$1/$2\";};f"
  close-issue = "!f(){ git commit --allow-empty -m \"Closed #$1\";};f"
  list-merged-branches = !git branch --merged origin/release-candidate
  delete-merged-branches = !git branch --merged origin/release-candidate | grep -vE '^[*+]|release-candidate|staging|main|master' | xargs -r git branch -d
  delete-merged-worktrees = "!f(){ git rev-parse --verify -q origin/release-candidate >/dev/null || { echo 'origin/release-candidate が見つかりません'; return 1; }; git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch /{sub(\"refs/heads/\",\"\",$2); print $2\" \"w}' | while read -r b p; do case \"$b\" in release-candidate|staging|main|master) continue;; esac; if ! git merge-base --is-ancestor \"refs/heads/$b\" origin/release-candidate 2>/dev/null; then echo \"skipped (unmerged): $p ($b)\"; continue; fi; st=$(git -C \"$p\" status --porcelain 2>/dev/null) || { echo \"skipped (status failed): $p ($b)\"; continue; }; if [ -n \"$st\" ]; then echo \"skipped (dirty): $p ($b)\"; continue; fi; if git worktree remove \"$p\"; then echo \"removed: $p ($b)\"; else echo \"skipped (remove refused): $p ($b)\"; fi; done; }; f"
[color]
  ui = auto
[log]
  decorate = short
[push]
  default = simple
  autoSetupRemote = true
[pull]
  ff = only
[merge]
  tool = vimdiff
  ff = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
  required = true
	process = git-lfs filter-process
[init]
	defaultBranch = main
